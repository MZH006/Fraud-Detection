# Application Configuration
APP_NAME=Fraud Detection API
DEBUG=false
LOG_LEVEL=INFO

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Database (Supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
CACHE_TTL=300

# Model Configuration
MODEL_PATH=./artifacts/fraud_detection_model_final.pkl
# Leave unset to use the threshold saved with the model artifact
# MODEL_THRESHOLD=

# Feature Engineering Thresholds
HIGH_AMOUNT_THRESHOLD=200.0
HIGH_DEVIATION_THRESHOLD=2.0
HIGH_RISK_FRAUD_RATE=0.05

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# Security
API_KEY_ENABLED=false
API_KEY=your-secret-api-key-here
CORS_ORIGINS=["*"]
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
